rules_version = '2';

// Orientaa Firebase Storage security rules.
//
// Deploy with:  firebase deploy --only storage
// (requires the Firebase CLI and firebase.json wired to this file)
//
// Ownership model:
//  - Users may only write under paths owned by their uid.
//  - Public images (profile photos, post images) are readable by any signed-
//    in user so they render for others.
//  - Sensitive verification documents (government ID, professional
//    credentials) are readable ONLY by their owner and users holding the
//    `admin` custom claim — never by other students or counselors, and never
//    unauthenticated. The `admin` claim is the same one already enforced in
//    firestore.rules (counselorProfiles/counselorPrivate/adminDisputeQueue)
//    and in the Cloud Functions.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public images: any image type, capped at 10MB.
    function isSmallImage() {
      return request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Public post images: slightly larger cap (15MB) for camera captures.
    function isPostImage() {
      return request.resource.size < 15 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Verification documents: images OR PDFs only, capped at 10MB — anything
    // else (exe, zip, html, …) is rejected at the rules layer regardless of
    // what the client attempts to upload.
    function isDocument() {
      return request.resource.size < 10 * 1024 * 1024
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType.matches('application/pdf'));
    }

    // Profile photos: profile_photos/<uid>.jpg — the owner writes, everyone
    // signed in reads. The filename segment carries the uid (e.g. `abc123.jpg`),
    // so the rule binds it with a whole-segment wildcard + prefix check
    // (`{uid}.jpg` is not valid rules syntax).
    match /profile_photos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
          && fileName.startsWith(request.auth.uid + '.jpg')
          && isSmallImage();
    }

    // Post images: post_images/<uid>/<fileName> — owner writes, all
    // signed-in users read.
    match /post_images/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isPostImage();
    }

    // Counselor verification documents. The upload path is
    // counselor_ids/<uid>/document.<ext> (and the same shape under
    // counselor_credentials) — the uid lives in its own path segment so the
    // rules can bind it directly to request.auth.uid.
    //
    // READ:  owner OR admin only — students browsing the directory and other
    //        counselors can never resolve these blobs. The admin claim is the
    //        one already used by firestore.rules and the admin callables.
    // WRITE: owner only, image/PDF only, ≤10MB.
    match /counselor_ids/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && isDocument();
    }

    match /counselor_credentials/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && isDocument();
    }

    // Default: deny everything else. No path is readable or writable by
    // unauthenticated users, and no storage path is left on permissive
    // defaults.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
