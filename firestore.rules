rules_version = '2';

// Orientaa Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
// (requires the Firebase CLI and firebase.json wired to this file)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────
    // The user document is readable by anyone signed in (needed for search,
    // connections, and viewing public profiles). The owner can write their
    // own profile fields. Other signed-in users may ONLY adjust the aggregate
    // counters (followersCount / followingCount / postsCount) — this is what
    // follow(), unfollow() and createPost()/deletePost() do in batch writes,
    // so those operations keep working without opening up the whole doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followersCount', 'followingCount', 'postsCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Followers subcollection: anyone signed in can add/remove their own
      // follow record; followers lists are readable by signed-in users.
      match /followers/{followerUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == followerUid;
      }

      // Following subcollection: each user manages their own list.
      match /following/{targetUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Notifications: readable + updatable only by the owner.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Push device tokens: owner-only. The parent user document is readable
      // by all signed-in users (search/connections), so the FCM token must
      // never live on it — it lives here where only the owner can see it.
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Posts ────────────────────────────────────────────────────────────
    // Publicly readable; the author can create/update/delete their own posts.
    // Any signed-in user may like/unlike a post, which only touches the
    // `likedBy` array and `likesCount` counter.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'likedBy'])
      );
      allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
    }

    // ── Conversations + messages ─────────────────────────────────────────
    // A conversation is visible to its participants; the deterministic
    // conversation id is '<uidA>_<uidB>' (sorted), so a participant may only
    // create a conversation whose id contains their own uid.
    match /conversations/{conversationId} {
      allow read: if request.auth != null
          && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null
          && request.resource.data.participantIds.hasAny([request.auth.uid]);
      allow update: if request.auth != null
          && resource.data.participantIds.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if request.auth != null
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid]);
        // Participants may only send as themselves and only inside a
        // conversation they belong to.
        allow create: if request.auth != null
            && request.resource.data.senderId == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid]);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── Discovery catalogue (read-only for signed-in users) ─────────────
    match /universities/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Saved universities (owner-only) ──────────────────────────────────
    // Each user owns their saved items and folders under
    // `saved_universities/{uid}`. Saving is available to all tiers and
    // unlimited — these rules do not gate by subscription tier.
    match /saved_universities/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /items/{programId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /folders/{folderId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── User interaction events (owner-only, for the recommendation engine)
    match /user_interactions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /classrooms/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /sessions/{docId} {
      allow read: if request.auth != null;
      // Sessions are created/updated by the involved student/counsellor.
      allow create: if request.auth != null
          && (request.resource.data.studentId == request.auth.uid
              || request.resource.data.counsellorId == request.auth.uid);
      allow update: if request.auth != null
          && (resource.data.studentId == request.auth.uid
              || resource.data.counsellorId == request.auth.uid);
      allow delete: if false;
    }

    // ── Counselors module ────────────────────────────────────────────────
    // Marketplace profile: public once approved; the owner may always read
    // and edit their own. Approval (verificationStatus), aggregates
    // (ratingAverage/ratingCount) and presence (isOnline/lastActiveAt) are
    // only ever written by Cloud Functions via the Admin SDK, which bypasses
    // these rules — the owner's write is limited to their own public fields.
    match /counselorProfiles/{uid} {
      // Everyone signed in can read approved profiles (directory); the owner
      // reads their own (review screen); admins may read any profile so the
      // verification queue can list pending/rejected applications.
      allow read: if request.auth != null
          && (request.auth.uid == uid
              || resource.data.verificationStatus == 'approved'
              || request.auth.token.admin == true);
      // The owner may only write their own PUBLIC fields. verificationStatus,
      // ratingAverage/ratingCount, isOnline/lastActiveAt and recommendedScore
      // are written exclusively by Cloud Functions (Admin SDK, bypasses these
      // rules) — a client can never self-approve or fake its ratings.
      allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
              'uid', 'displayName', 'legalName', 'photoUrl', 'bio',
              'institution', 'yearsOfExperience', 'specialties',
              'languages', 'hourlyRate', 'currency', 'availability',
              'socialLinks', 'createdAt', 'updatedAt',
          ]);
      allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'legalName', 'photoUrl', 'bio',
              'institution', 'yearsOfExperience', 'specialties',
              'languages', 'hourlyRate', 'currency', 'availability',
              'socialLinks', 'updatedAt',
          ]);
      allow delete: if false;
    }

    // Private per-counselor document: government-ID + credentials document
    // URLs and the Flutterwave payout target. Readable only by the owner and
    // users holding the `admin` custom claim — never by students browsing the
    // directory. Admins write via the Admin SDK (bypasses rules); the owner
    // writes only through the saveCounselorProfile/submitVerification callables.
    match /counselorPrivate/{uid} {
      allow read: if request.auth != null
          && (request.auth.uid == uid || request.auth.token.admin == true);
      // The owner may only maintain their private fields (documents, payout
      // target) through the callables. aiScreeningResult is written by the
      // screening function (Admin SDK bypasses these rules) and a client can
      // never forge it — the diff check rejects any write touching it.
      allow write: if request.auth != null
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['aiScreeningResult']);
    }

    // Bookings: participants may read; ALL state changes (create, payment,
    // confirmation, dispute, payout) go through Cloud Functions, so clients
    // cannot write booking documents at all. Messages are readable/writable
    // by participants, with read-receipt-only updates.
    match /bookings/{bookingId} {
      allow read: if request.auth != null
          && (resource.data.studentUid == request.auth.uid
              || resource.data.counselorUid == request.auth.uid);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
            && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.studentUid == request.auth.uid
                || get(/databases/$(database)/documents/bookings/$(bookingId)).data.counselorUid == request.auth.uid);
        // Session chat is only writable during the live window: participant
        // AND sender must be the caller AND the booking is confirmed/
        // in_progress AND we're inside [start - 10min, end + 30min grace].
        // The client also gates the input; these rules enforce it server-side.
        allow create: if request.auth != null
            && request.resource.data.senderUid == request.auth.uid
            && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.studentUid == request.auth.uid
                || get(/databases/$(database)/documents/bookings/$(bookingId)).data.counselorUid == request.auth.uid)
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status in ['confirmed', 'in_progress']
            && request.time >= get(/databases/$(database)/documents/bookings/$(bookingId)).data.scheduledStart - duration(10, 'minutes')
            && request.time <= get(/databases/$(database)/documents/bookings/$(bookingId)).data.scheduledEnd + duration(30, 'minutes');
        allow update: if request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readAt']);
        allow delete: if false;
      }
    }

    // Ratings: publicly readable (first name only is stored); written only
    // by the submitRating Cloud Function.
    match /ratings/{bookingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Admin dispute queue: readable only by users holding the `admin` custom
    // claim (Firebase console -> Authentication -> custom claims). Written
    // exclusively by Cloud Functions.
    match /adminDisputeQueue/{bookingId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Admin alerts (e.g. overdue counselor applications flagged by the
    // scheduled function): admin-read only, written by Cloud Functions.
    match /adminAlerts/{alertId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}
